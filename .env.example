# ── Jeton que n8n devra présenter (Bearer) ───────────────────────────────────
# C'est le seul verrou du serveur MCP : qui l'a pilote l'agenda.
# En générer un : node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
MCP_TOKEN=remplacer-par-un-jeton-genere

# ── Compte BranShee utilisé par le MCP ───────────────────────────────────────
# Ses permissions déterminent ce que n8n pourra faire. Recommandé : un compte
# collaborateur dédié, avec un grade limité, et SANS double authentification
# (une 2FA rend la connexion automatique impossible).
BRANSHEE_EMAIL=
BRANSHEE_PASSWORD=

# Établissement ciblé. Laisser vide = établissement par défaut du compte.
# Obtenir la liste avec l'outil « lister_etablissements ».
BRANSHEE_COMPANY_ID=

# ── Réglages ─────────────────────────────────────────────────────────────────
BRANSHEE_API_URL=https://www.branshee.com/api/v1
PORT=3020

# true = seuls les outils de LECTURE sont exposés (aucune création, annulation
# ni modification possible). À laisser true tant qu'un workflow n'est pas sûr.
MCP_READ_ONLY=false
